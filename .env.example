# 复制成 .env；密钥只保存在本机服务端，切勿提交、发到聊天或写入前端。
DASHSCOPE_API_KEY=
# 从百炼控制台复制实际地域/工作空间的 OpenAI 兼容接口地址。
# 北京示例（将 YOUR_WORKSPACE_ID 替换为真实工作空间 ID）：
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 需在你的地域及账号中可用，并支持图片与 JSON 输出。
QWEN_MODEL=qwen3.7-plus
QWEN_ENABLE_THINKING=false
QWEN_TIMEOUT_MS=120000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# 本机单用户可留空；若需非回环地址监听，必须同时配置强密码及 APP_ORIGIN。
APP_PASSWORD=
APP_ORIGIN=
